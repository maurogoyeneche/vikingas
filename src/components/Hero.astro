---
import { Image } from "astro:assets";
import head_spa from "../images/head_spa.webp";

interface Props {
  title: string;
  content: string;
}

const { title, content } = Astro.props;
---

<section class="hero">
  <div class="hero-content">
    <Image
      src={head_spa}
      alt="Head Spa Capilar"
      class="hero-image"
      width={600}
      format="webp"
    />
    <div class="hero-overlay">
      <h2 class="text-gradient">{title}</h2>
      <h3>{content}</h3>
    </div>
  </div>
</section>

<style>
  .hero {
    width: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    background-color: #000;
    color: white;
    margin: 3rem auto;
  }

  .hero-content {
    position: relative;
    text-align: center;
  }

  .hero h1 {
    font-size: 4rem;
    margin: 1rem 0;
    font-weight: 700;
  }
  .hero-content h3 {
    font-size: 1.5rem;
    margin: 1rem 0;
    line-height: 1.5;
  }
  .hero-image {
    margin: 0 auto;
    height: auto;
  }
  .hero-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-image: radial-gradient(
      circle,
      rgba(0, 0, 0, 0.3) 30%,
      rgba(0, 0, 0, 0.95) 70%
    );
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
  }
  .hero-overlay h2 {
    max-width: 400px;
    font-size: 2rem;
    line-height: 1.5;
    color: rgba(245, 245, 245, 0.791);
    font-weight: 600;
  }
  .hero-overlay h3 {
    max-width: 400px;
    font-size: 1.2rem;
    line-height: 1.5;
    color: rgba(245, 245, 245, 0.612);
    text-align: center;
  }
  .text-gradient {
    background-image: var(--accent-gradient);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-size: 400%;
    background-position: 0%;
  }
  @media (max-width: 768px) {
    .hero {
      height: auto;
      flex-direction: column;
    }
    .hero-content {
      text-align: left;
    }
    .hero-content h1 {
      font-size: 2.5rem;
    }
    .hero-content p {
      font-size: 1.2rem;
    }
  }
</style>
<style>
  @media (max-width: 768px) {
    .hero-content h1 {
      font-size: 2.5rem;
    }
    .hero-content p {
      font-size: 1.2rem;
    }
  }
</style>
